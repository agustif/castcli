{
  "compilerOptions": {
    // Build performance
    "incremental": true,

    // Module system
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "types": ["node"],

    // Import handling
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,

    // Type safety
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Development
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,

    "rootDir": "src",
    "outDir": "dist",

    // Effect Language Service: better diagnostics and refactors for Effect code
    "plugins": [{ "name": "@effect/language-service" }]
  },
  "include": ["src/**/*.ts"]
}
