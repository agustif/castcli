{
  "compilerOptions": {
    // Build performance
    "incremental": true,

    // Module system
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "types": ["node"],

    // Import handling
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,

    // Workspace resolution without a build step: each package name maps to its
    // barrel, so tsc, tsx and vitest all agree and there is no intermediate
    // dist/ to keep in sync while iterating.
    "paths": {
      "@castcli/domain": ["./packages/domain/src/index.ts"],
      "@castcli/protocol": ["./packages/protocol/src/index.ts"],
      "@castcli/media": ["./packages/media/src/index.ts"],
      "@castcli/quality": ["./packages/quality/src/index.ts"],
      "@castcli/platform": ["./packages/platform/src/index.ts"],
      "@castcli/emulator": ["./packages/emulator/src/index.ts"],
      "@castcli/dlna": ["./packages/dlna/src/index.ts"]
    },

    // Type safety
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Development
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,

    "outDir": "dist",

    // Effect Language Service: better diagnostics and refactors for Effect code
    "plugins": [{ "name": "@effect/language-service" }]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "scripts/**/*.ts",
    "tools/*/src/**/*.ts"
  ]
}
