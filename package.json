{
  "name": "castcli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cast": "tsx apps/cli/src/bin/cast.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "codegen": "tsx scripts/generate-protocol.ts",
    "codegen:check": "tsx scripts/generate-protocol.ts --check",
    "depcruise": "depcruise \"packages/**/*.ts\" \"apps/**/*.ts\" --config .dependency-cruiser.cjs --output-type err",
    "graph": "depcruise \"packages/**/*.ts\" \"apps/**/*.ts\" --config .dependency-cruiser.cjs --output-type dot > docs/dependency-graph.dot",
    "check": "npm run typecheck && npm run lint && npm run depcruise && npm run codegen:check && npm run test"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-rc.109",
    "effect": "^4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "^4.0.0-rc.109",
    "@types/node": "^26.2.0",
    "dependency-cruiser": "^18.2.0",
    "effect-oxlint": "^0.3.3",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ]
}